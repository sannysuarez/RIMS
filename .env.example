# Environment variables for Flask application
# Copy this to .env and fill in appropriate values

FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=dev-secret-key-change-in-production

# Database configuration
# For development: SQLite (automatic)
# For production: Use PostgreSQL URL
DATABASE_URL=sqlite:///raasu.db

# Server configuration
FLASK_DEBUG=True
FLASK_TESTING=False
